,\"p\",null,{\"className\":\"product-page-module__hCsNkW__summary\",\"children\":\"Upcube Mobile OS is the public mobile operating-system vision in the ecosystem, built around trusted launch, privacy-aware intelligence, clear system boundaries, and a public consumer release planned for 2028 while improvements continue.\"}],[\"$\",\"div\",null,{\"className\":\"product-page-module__hCsNkW__actionRow\",\"children\":[[\"$\",\"$L3\",null,{\"href\":\"/vision\",\"className\":\"uc-button\",\"data-variant\":\"solid\",\"children\":\"Read the vision\"}],[\"$\",\"$L3\",null,{\"href\":\"/trust\",\"className\":\"uc-button\",\"children\":\"Explore trust\"}]]}]]}],[\"$\",\"aside\",null,{\"className\":\"product-page-module__hCsNkW__heroVisual\",\"aria-label\":\"Upcube Mobile OS highlights\",\"children\":[[\"$\",\"div\",null,{\"className\":\"product-page-module__hCsNkW__visualGlow\"}],[\"$\",\"div\",null,{\"className\":\"product-page-module__hCsNkW__highlightStack\",\"children\":[[\"$\",\"article\",\"AI as a system layer, not just an assistant icon.\",{\"className\":\"product-page-module__hCsNkW__highlightCard\",\"children\":[\"$\",\"p\",null,{\"children\":\"AI as a system layer, not just an assistant icon.\"}]}],[\"$\",\"article\",\"Privacy-aware intelligence with clearer user control.\",{\"className\":\"product-page-module__hCsNkW__highlightCard\",\"children\":[\"$\",\"p\",null,{\"children\":\"Privacy-aware intelligence with clearer user control.\"}]}],[\"$\",\"article\",\"Public consumer release planned for 2028 while improvements continue.\",{\"className\":\"product-page-module__hCsNkW__highlightCard\",\"children\":[\"$\",\"p\",null,{\"children\":\"Public consumer release planned for 2028 while improvements continue.\"}]}]]}]]}]]}]}]}],[\"$\",\"section\",null,{\"className\":\"product-page-module__hCsNkW__section\",\"children\":[\"$\",\"div\",null,{\"className\":\"uc-shell\",\"children\":[[\"$\",\"div\",null,{\"className\":\"product-page-module__hCsNkW__sectionIntro\",\"children\"