COMPANY_NAME="Vercel Inc."
SITE_NAME="Next.js Commerce"
SHOPIFY_REVALIDATION_SECRET=""
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_STORE_DOMAIN="[your-shopify-store-subdomain].myshopify.com"

# Upcube Account Service — central identity provider
NEXT_PUBLIC_ACCOUNT_URL=https://account.upcube.ai
# Set in Cloudflare Pages dashboard:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# ACCOUNT_SESSION_SECRET=
# ALLOWED_RETURN_TO_DOMAINS=upcube.ai,news.upcube.ai,books.upcube.ai,jobs.upcube.ai,planet.upcube.ai,quantum.upcube.ai
# COOKIE_DOMAIN=.upcube.ai
# ACCOUNT_DATABASE_URL=

# Tavus Conversation API — required for "Talk to Ethen" avatar widget
# Set in Cloudflare Pages dashboard (do not commit to env files):
# TAVUS_API_KEY=
# TAVUS_REPLICA_ID=

# Tavus — AI video conversations
# Set in Cloudflare Pages dashboard or .env:
# TAVUS_API_KEY=
# TAVUS_REPLICA_ID=
# TAVUS_PERSONA_ID=
